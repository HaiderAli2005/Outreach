generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity ───────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String?
  name            String?
  status          UserStatus     @default(ACTIVE)
  isPlatformAdmin Boolean        @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  memberships     Membership[]
  oauthAccounts   OAuthAccount[]
  refreshTokens   RefreshToken[]
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// ─── Tenancy ────────────────────────────────────────────────────────────────

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INVITED
}

model Organization {
  id               String             @id @default(cuid())
  name             String
  primaryDomain    String?
  status           OrganizationStatus @default(ACTIVE)
  stripeCustomerId String?            @unique
  webhookToken     String             @unique @default(cuid())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  memberships      Membership[]
  settings         OrgSettings?
  onboarding       Onboarding?
  subscription     Subscription?
  payments         Payment[]
  invoices         Invoice[]
  credentials      IntegrationCredential[]
  campaigns        Campaign[]
  contacts         Contact[]
  companies        Company[]
  messages         Message[]
  blocklist        BlocklistEntry[]
  batches          WeeklyBatch[]
  autoReplyQueue   AutoReplyQueue[]
  autoReplyLog     AutoReplyDecision[]
  systemLogs       SystemLog[]
  usage            UsageCounter[]
  sendingDomains   SendingDomain[]
  mailboxes        Mailbox[]
}

model Membership {
  id              String           @id @default(cuid())
  organizationId  String
  userId          String?
  role            MemberRole       @default(MEMBER)
  status          MembershipStatus @default(ACTIVE)
  invitedEmail    String?
  inviteTokenHash String?          @unique
  inviteExpiresAt DateTime?
  createdAt       DateTime         @default(now())
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@unique([organizationId, invitedEmail])
  @@index([userId])
}

// ─── Billing ────────────────────────────────────────────────────────────────

model Plan {
  id                String         @id
  name              String
  maxDailyVolume    Int
  priceMonthlyCents Int
  maxCampaigns      Int?
  features          Json
  stripePriceId     String?
  sortOrder         Int            @default(0)
  active            Boolean        @default(true)
  subscriptions     Subscription[]
}

enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELED
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  planId               String
  status               SubscriptionStatus @default(INCOMPLETE)
  stripeSubscriptionId String?            @unique
  dailyVolume          Int
  inboxQuantity        Int
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                 Plan               @relation(fields: [planId], references: [id])

  @@index([status])
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                    String        @id @default(cuid())
  organizationId        String
  stripePaymentIntentId String        @unique
  stripeInvoiceId       String?
  amountCents           Int
  amountRefundedCents   Int           @default(0)
  currency              String        @default("usd")
  status                PaymentStatus @default(REQUIRES_PAYMENT)
  failureMessage        String?
  description           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  refunds               Refund[]

  @@index([organizationId, createdAt])
  @@index([status])
}

model Refund {
  id             String   @id @default(cuid())
  paymentId      String
  stripeRefundId String   @unique
  amountCents    Int
  reason         String?
  status         String
  createdById    String?
  createdAt      DateTime @default(now())
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model Invoice {
  id               String       @id @default(cuid())
  organizationId   String
  stripeInvoiceId  String       @unique
  number           String?
  status           String
  amountDueCents   Int
  amountPaidCents  Int
  currency         String       @default("usd")
  hostedInvoiceUrl String?
  pdfUrl           String?
  periodStart      DateTime?
  periodEnd        DateTime?
  createdAt        DateTime     @default(now())
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

enum WebhookProvider {
  STRIPE
  SMARTLEAD
  CALENDLY
  APOLLO
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

model WebhookEvent {
  id             String          @id @default(cuid())
  provider       WebhookProvider
  externalId     String
  type           String
  organizationId String?
  status         WebhookStatus   @default(RECEIVED)
  error          String?
  payload        Json
  receivedAt     DateTime        @default(now())
  processedAt    DateTime?

  @@unique([provider, externalId])
  @@index([provider, receivedAt])
  @@index([status])
}

// ─── Onboarding & sending infrastructure ────────────────────────────────────

model Onboarding {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  domain           String
  brand            String
  summary          String?
  icp              Json
  preview          Json?
  volume           Int          @default(1000)
  warmupDays       Int          @default(21)
  inboxesPerDomain Int          @default(3)
  provider         String       @default("google")
  analyzedAt       DateTime?
  analysisError    String?
  paidAt           DateTime?
  launchedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum SendingDomainStatus {
  SELECTED
  PENDING_REGISTRATION
  REGISTERED
  FAILED
}

model SendingDomain {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  priceCents     Int
  status         SendingDomainStatus @default(SELECTED)
  forwardTo      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mailboxes      Mailbox[]

  @@unique([organizationId, name])
}

enum MailboxStatus {
  PLANNED
  PENDING
  WARMING
  ACTIVE
  ERROR
}

model Mailbox {
  id                 String         @id @default(cuid())
  organizationId     String
  sendingDomainId    String?
  address            String
  provider           String         @default("google")
  status             MailboxStatus  @default(PLANNED)
  smartleadAccountId String?
  warmupDays         Int            @default(21)
  dailyLimit         Int            @default(40)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sendingDomain      SendingDomain? @relation(fields: [sendingDomainId], references: [id], onDelete: SetNull)

  @@unique([organizationId, address])
}

// ─── Settings & credentials ─────────────────────────────────────────────────

enum AutoReplyMode {
  OFF
  SHADOW
  CANARY
  LIVE
}

model OrgSettings {
  organizationId             String        @id
  autopilotEnabled           Boolean       @default(false)
  weeklyBatchMode            Boolean       @default(true)
  autoApproveBatches         Boolean       @default(false)
  defaultDailySendCap        Int           @default(100)
  perMailboxDailyCap         Int           @default(30)
  blocklistNoReplyDays       Int           @default(7)
  timezone                   String        @default("Europe/London")
  sendingWindowStart         String        @default("09:00")
  sendingWindowEnd           String        @default("17:00")
  language                   String        @default("en")
  personalizationEnabled     Boolean       @default(true)
  requireVerifiedEmail       Boolean       @default(true)
  monthlyCreditCap           Int           @default(0)
  dailyCreditCap             Int           @default(0)
  dailySourceTarget          Int           @default(100)
  expectedBounceRate         Float         @default(0.18)
  apolloCycleResetDay        Int           @default(1)
  perCompanyContactCap       Int           @default(2)
  senderName                 String?
  senderCompany              String?
  senderTitle                String?
  senderAddress              String?
  meetingLink                String?
  valueProp                  String?
  optOutLine                 String?
  brandProfile               Json?
  smartleadDefaultCampaignId String?
  smartleadMailboxIds        Int[]         @default([])
  slackChannel               String?
  browserNotifications       Boolean       @default(false)
  autoReplyEnabled           Boolean       @default(false)
  autoReplyMode              AutoReplyMode @default(OFF)
  autoReplyKillSwitch        Boolean       @default(false)
  autoReplyMinConfidence     Float         @default(0.75)
  autoReplyMaxTurns          Int           @default(10)
  autoReplyMaxAutoSends      Int           @default(4)
  autoReplyDailyCap          Int           @default(10)
  autoReplyThreadGapMinutes  Int           @default(60)
  autoReplyWindowStart       Int           @default(8)
  autoReplyWindowEnd         Int           @default(18)
  autoReplyCanaryCampaigns   String[]      @default([])
  autoReplySoftAck           Boolean       @default(false)
  updatedAt                  DateTime      @updatedAt
  organization               Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum IntegrationProvider {
  APOLLO
  SMARTLEAD
  MILLIONVERIFIER
  SLACK_WEBHOOK
}

model IntegrationCredential {
  id             String              @id @default(cuid())
  organizationId String
  provider       IntegrationProvider
  ciphertext     String
  last4          String
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
}

// ─── Outreach engine ────────────────────────────────────────────────────────

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

model Campaign {
  id                  String         @id @default(cuid())
  organizationId      String
  name                String
  niche               String?
  marketBrief         String?
  status              CampaignStatus @default(DRAFT)
  language            String         @default("en")
  smartleadCampaignId String?        @unique
  apolloFilters       Json           @default("{}")
  dailySendCap        Int            @default(50)
  sourcePage          Int            @default(1)
  saturatedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts            Contact[]

  @@index([organizationId, status])
}

model Company {
  id             String       @id @default(cuid())
  organizationId String
  domain         String
  name           String?
  website        String?
  industry       String?
  employees      Int?
  description    String?
  linkedinUrl    String?
  city           String?
  country        String?
  technologies   Json?
  keywords       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, domain])
}

enum ContactStatus {
  NEW
  PERSONALIZED
  QUEUED
  CONTACTED
  REPLIED
  NO_RESPONSE
  BLOCKLISTED
  UNSUBSCRIBED
  BOUNCED
  REJECTED
}

enum AutoReplyStatus {
  AUTO
  MANUAL
  PAUSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model Contact {
  id                    String            @id @default(cuid())
  organizationId        String
  email                 String
  emailNormalized       String
  domain                String?
  companyDomain         String?
  firstName             String?
  lastName              String?
  fullName              String?
  title                 String?
  company               String?
  website               String?
  linkedinUrl           String?
  location              String?
  city                  String?
  country               String?
  phone                 String?
  industry              String?
  seniority             String?
  headline              String?
  photoUrl              String?
  apolloId              String?
  campaignId            String?
  batchId               String?
  source                String            @default("apollo")
  status                ContactStatus     @default(NEW)
  personalizationStatus String            @default("pending")
  personalization       String?
  messageSubject        String?
  followup2             String?
  followup3             String?
  emailStatus           String?
  verifyResult          String?
  verifyQuality         String?
  verifiedAt            DateTime?
  fitScore              Int               @default(0)
  tier                  String?
  smartleadLeadId       String?
  smartleadCampaignId   String?
  firstContactedAt      DateTime?
  lastContactedAt       DateTime?
  repliedAt             DateTime?
  replyClass            String?
  replyUrgent           Boolean           @default(false)
  aiDraft               String?
  aiDraftAt             DateTime?
  followUpAt            DateTime?
  handledAt             DateTime?
  meetingBookedAt       DateTime?
  autoReplyStatus       AutoReplyStatus   @default(AUTO)
  autoReplyCount        Int               @default(0)
  lastAutoReplyAt       DateTime?
  linkSentAt            DateTime?
  handoffAt             DateTime?
  neverAuto             Boolean           @default(false)
  lastEscalationReason  String?
  lastMessageAt         DateTime?
  lastMessageDirection  MessageDirection?
  lastMessagePreview    String?
  messageCount          Int               @default(0)
  hasInbound            Boolean           @default(false)
  raw                   Json?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign              Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  batch                 WeeklyBatch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)
  messages              Message[]

  @@unique([organizationId, emailNormalized])
  @@index([organizationId, status])
  @@index([organizationId, campaignId])
  @@index([organizationId, batchId])
  @@index([organizationId, companyDomain])
  @@index([organizationId, replyUrgent])
  @@index([organizationId, lastMessageAt])
  @@index([organizationId, lastContactedAt])
  @@index([organizationId, fitScore])
  @@index([smartleadLeadId])
}

model Message {
  id                 String           @id @default(cuid())
  organizationId     String
  contactId          String
  campaignId         String?
  direction          MessageDirection
  via                String?
  subject            String?
  body               String?
  intent             String?
  classifyStartedAt  DateTime?
  classifyAttempts   Int              @default(0)
  smartleadStatsId   String?
  smartleadMessageId String?
  meta               Json?
  createdAt          DateTime         @default(now())
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact            Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([organizationId, contactId, createdAt])
  @@index([organizationId, direction, createdAt])
  @@index([organizationId, intent])
}

enum BlockEntryType {
  EMAIL
  DOMAIN
}

enum BlockReason {
  ALREADY_CONTACTED
  NO_RESPONSE
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
  MANUAL
  COMPETITOR
  CUSTOMER
  DEAL_CLOSED
  REMOVED
}

model BlocklistEntry {
  id             String         @id @default(cuid())
  organizationId String
  entryType      BlockEntryType
  value          String
  reason         BlockReason    @default(MANUAL)
  note           String?
  contactId      String?
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entryType, value])
  @@index([organizationId, reason])
  @@index([organizationId, createdAt])
}

enum BatchStatus {
  SOURCING
  REVIEW
  APPROVED
  SENDING
  DONE
}

model WeeklyBatch {
  id             String       @id @default(cuid())
  organizationId String
  weekStart      DateTime     @db.Date
  status         BatchStatus  @default(SOURCING)
  targetClean    Int          @default(0)
  sourcedClean   Int          @default(0)
  excludedCount  Int          @default(0)
  approvedCount  Int?
  approvedAt     DateTime?
  lastNagAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts       Contact[]

  @@unique([organizationId, weekStart])
  @@index([organizationId, status])
}

enum QueueStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

model AutoReplyQueue {
  id               String       @id @default(cuid())
  organizationId   String
  contactId        String
  triggerMessageId String       @unique
  replyClass       String?
  language         String?
  draft            String
  includeLink      Boolean      @default(false)
  sendAfter        DateTime
  status           QueueStatus  @default(PENDING)
  attempts         Int          @default(0)
  cancelReason     String?
  lastError        String?
  claimedAt        DateTime?
  sentAt           DateTime?
  createdAt        DateTime     @default(now())
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, sendAfter])
  @@index([contactId])
}

model AutoReplyDecision {
  id             String       @id @default(cuid())
  organizationId String
  contactId      String?
  messageId      String?
  mode           String
  replyClass     String?
  wouldSend      Boolean      @default(false)
  skipReason     String?
  confidence     Float?
  language       String?
  includeLink    Boolean      @default(false)
  turnCount      Int?
  body           String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

enum LogLevel {
  INFO
  WARN
  ERROR
  CRITICAL
}

model SystemLog {
  id             String        @id @default(cuid())
  organizationId String?
  level          LogLevel      @default(ERROR)
  source         String
  message        String
  meta           Json?
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, resolvedAt, level])
  @@index([createdAt])
}

model UsageCounter {
  id             String       @id @default(cuid())
  organizationId String
  day            DateTime     @db.Date
  peopleEnriched Int          @default(0)
  searches       Int          @default(0)
  emailsVerified Int          @default(0)
  aiCalls        Int          @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, day])
}

# ── Runtime ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Public origins (comma separated) allowed by CORS; the web app origin in production
WEB_ORIGIN=http://localhost:3100
# Public base URL of the API as reached by third parties (webhook URLs are built from it)
PUBLIC_API_URL=http://localhost:4000

# ── Data stores ───────────────────────────────────────────
DATABASE_URL=postgresql://aperture:aperture@localhost:55432/aperture?schema=public&connection_limit=10
# Optional. When unset, job locks use Postgres advisory locks and rate limits use memory.
REDIS_URL=redis://localhost:6379

# ── Secrets (Secret Manager in production) ────────────────
# 32+ random bytes each, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
# 32 bytes, base64 encoded: `openssl rand -base64 32`
ENCRYPTION_KEY=
# Shared secret Cloud Scheduler sends in X-Jobs-Secret
JOBS_SECRET=change-me-jobs-secret
# Shared secret appended to Smartlead / Calendly / Apollo webhook URLs (?token=)
WEBHOOK_SECRET=change-me-webhook-secret
# HMAC key for the one-click batch approval links
APPROVE_LINK_SECRET=change-me-approve-secret

# ── Google OAuth 2.0 (optional) ───────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/oauth/google/callback

# ── Stripe (optional; billing returns 503 when unset) ─────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LAUNCH=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_INBOX_FAST=
INBOX_FAST_PRICE_CENTS=
STRIPE_PRICE_INBOX=

# ── Email through Mailgun SMTP (optional) ──────────────
# When all four of MAIL_HOST, MAIL_USER, MAIL_PASS and MAIL_FROM are set, new accounts confirm their
# email with number match and "Forgot password" works. When any is empty, sign up works without it.
# EU Mailgun accounts use smtp.eu.mailgun.org.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# ── AI (optional; analysis, drafts and personalization need it) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# The business analysis and sample emails, best model first. Skipped automatically if your account doesn't have it.
OPENAI_ANALYSIS_MODEL=gpt-6-luna,gpt-4.1

# ── Platform-level integration keys (used when a tenant has not set its own) ──
APOLLO_API_KEY=
SMARTLEAD_API_KEY=
MILLIONVERIFIER_API_KEY=
SLACK_WEBHOOK_URL=

# Emergency stop for every tenant's autonomous replies
AUTO_REPLY_KILL=0

# ── Onboarding analysis ─────────────────────────────────
# Live progress stream for the business analysis. Set to false to use the old single request.
ANALYSIS_STREAM=true
# One organisation-level count per audience for a true company total. Costs 1 Apollo credit per audience.
ACCURATE_COMPANY_COUNT=false

# ── Infraforge: sending domains and inboxes (bought and set up automatically after payment) ──
# API key from Infraforge → Settings → API. Leave empty to keep domains and inboxes manual.
INFRAFORGE_API_KEY=
# Registrant details for the domains you buy (the registrar requires all of them).
INFRAFORGE_CONTACT_FIRST_NAME=
INFRAFORGE_CONTACT_LAST_NAME=
INFRAFORGE_CONTACT_EMAIL=
INFRAFORGE_CONTACT_PHONE=
INFRAFORGE_CONTACT_ORG=
INFRAFORGE_CONTACT_ADDRESS=
INFRAFORGE_CONTACT_CITY=
INFRAFORGE_CONTACT_PROVINCE=
INFRAFORGE_CONTACT_POSTAL_CODE=
# Two-letter country code, e.g. GB or PK
INFRAFORGE_CONTACT_COUNTRY=
# DMARC reports mailbox and policy (none, quarantine or reject)
INFRAFORGE_DMARC_EMAIL=
INFRAFORGE_DMARC_POLICY=quarantine
# Customers sending at least this many emails a day get their own dedicated IP ($99/month each at Infraforge)
INFRAFORGE_DEDICATED_IP_MIN_VOLUME=2500
# SSL on domain forwarding so https:// links to sending domains work (about $2 a domain a month)
INFRAFORGE_SSL_FORWARDING=true
# Never buy a sending domain above this price, in cents
INFRAFORGE_MAX_DOMAIN_PRICE_CENTS=5000
# Days after a subscription ends before its inboxes are deleted and domain renewal is turned off
INFRAFORGE_RELEASE_AFTER_DAYS=7
# Runs the setup job every minute inside the API. On by default in development.
INFRA_POLL_IN_PROCESS=
